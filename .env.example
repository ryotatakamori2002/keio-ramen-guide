# Keio Ramen Guide — 環境変数テンプレ
# これらが未設定でもローカル開発・build は動作する（投稿機能だけが無効化される）。
# 値を入れたら .env.local にコピーして使う（.env.local は git 管理しない）。

# Supabase プロジェクトの URL（例: https://xxxx.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon キー（公開用。将来クライアント読み取りに使用）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role キー（サーバー専用。投稿作成・承認・画像アップロードに使用）
# 絶対にクライアントへ露出させないこと。NEXT_PUBLIC_ を付けない。
SUPABASE_SERVICE_ROLE_KEY=

# /admin（投稿承認画面）に入るための簡易パスワード
ADMIN_PASSWORD=
